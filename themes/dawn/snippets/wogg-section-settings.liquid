{%- style -%}
  #shopify-section-{{ section.id }} .wogg-base-section--transparent {
    background: transparent;
  }
  #shopify-section-{{ section.id }} .wogg-base-section {
    padding-top: {{ section.settings.padding_top | default: 0 | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 0 | times: 0.75 | round: 0 }}px;
  }
  #shopify-section-{{ section.id }} .wogg-base-section--full .page-width {
    max-width: none;
  }
  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .wogg-base-section {
      padding-top: {{ section.settings.padding_top | default: 0 }}px;
      padding-bottom: {{ section.settings.padding_bottom | default: 0 }}px;
    }
  }
{%- endstyle -%}
