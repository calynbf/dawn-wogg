{% render 'wogg-section-settings', section: section %}
<div class="wogg-base-section color-{{ section.settings.color_scheme }} gradient{% if section.settings.full_width %} wogg-base-section--full{% endif %}{% unless section.settings.use_background %} wogg-base-section--transparent{% endunless %}"><section class="wogg-section wogg-content-section wogg-community wogg-community--slider"><div class="page-width"><header class="wogg-community-slider__header"><h2 class="wogg-community-slider__title">Unite a nuestra <span>familia</span></h2></header><wogg-community-slider class="wogg-community-slider" data-autoplay="true"><div class="wogg-community-slider__viewport"><div class="wogg-community-slider__track">{% for block in section.blocks %}<a class="wogg-community-slider__slide" href="{{ block.settings.link | default: 'https://www.instagram.com/wogg.ok/' }}" target="_blank" rel="noopener" {{ block.shopify_attributes }}>{% if block.settings.image != blank %}{{ block.settings.image | image_url: width: 700 | image_tag: widths: '260,400,550,700', sizes: '(min-width:750px) 20vw,50vw', loading: 'lazy' }}{% else %}{% case forloop.index %}{% when 1 %}{% assign fallback_image = 'wogg-community-1.png' %}{% when 2 %}{% assign fallback_image = 'wogg-community-2.png' %}{% when 3 %}{% assign fallback_image = 'wogg-community-3.png' %}{% when 4 %}{% assign fallback_image = 'wogg-community-4.png' %}{% when 5 %}{% assign fallback_image = 'wogg-community-5.png' %}{% else %}{% assign fallback_image = 'wogg-community-6.png' %}{% endcase %}<img src="{{ fallback_image | asset_url }}" width="700" height="1000" loading="lazy" alt="Familia WOGG">{% endif %}</a>{% endfor %}</div></div><button class="wogg-community-slider__arrow wogg-community-slider__arrow--prev" type="button" aria-label="Diapositivas anteriores">‹</button><button class="wogg-community-slider__arrow wogg-community-slider__arrow--next" type="button" aria-label="Diapositivas siguientes">›</button><div class="wogg-community-slider__dots" role="tablist" aria-label="Paginación del carrusel"></div></wogg-community-slider></div></section></div>
{% schema %}
{"name":"WOGG - Comunidad","tag":"section","class":"section","max_blocks":12,"settings":[{"type":"text","id":"heading","label":"Título","default":"Unite a nuestra familia"},{"type":"header","content":"Configuración de sección"},{"type":"color_scheme","id":"color_scheme","label":"Esquema de color","default":"scheme-1"},{"type":"checkbox","id":"full_width","label":"Ancho completo","default":false},{"type":"checkbox","id":"use_background","label":"Mostrar fondo del esquema","default":false},{"type":"range","id":"padding_top","min":0,"max":100,"step":4,"unit":"px","label":"Margen superior","default":64},{"type":"range","id":"padding_bottom","min":0,"max":100,"step":4,"unit":"px","label":"Margen inferior","default":64}],"blocks":[{"type":"testimonial","name":"Imagen","settings":[{"type":"image_picker","id":"image","label":"Imagen"},{"type":"url","id":"link","label":"Enlace"}]}],"presets":[{"name":"WOGG - Comunidad","blocks":[{"type":"testimonial"},{"type":"testimonial"},{"type":"testimonial"},{"type":"testimonial"},{"type":"testimonial"},{"type":"testimonial"}]}]}
{% endschema %}
