{{ 'wogg-dawn-base.css' | asset_url | stylesheet_tag }}{% render 'wogg-section-settings', section: section %}
{{ 'wogg-home.css' | asset_url | stylesheet_tag }}{{ 'wogg-sections.css' | asset_url | stylesheet_tag }}
<div class="wogg-base-section color-{{ section.settings.color_scheme }} gradient{% if section.settings.full_width %} wogg-base-section--full{% endif %}{% unless section.settings.use_background %} wogg-base-section--transparent{% endunless %}"><section class="wogg-section wogg-content-section wogg-community"><div class="page-width"><header class="wogg-community__header"><div><p class="wogg-kicker">{{ section.settings.kicker | escape }}</p><h2 class="wogg-display wogg-section-title">{{ section.settings.heading | escape }}</h2></div><div class="wogg-section-copy rte">{{ section.settings.text }}</div></header><div class="wogg-grid wogg-community__grid">{% for block in section.blocks %}<article class="wogg-quote" {{ block.shopify_attributes }}><span class="wogg-quote__stars" aria-label="5 estrellas">★★★★★</span><blockquote>“{{ block.settings.quote | escape }}”</blockquote><span class="wogg-quote__author">{{ block.settings.author | escape }}</span></article>{% endfor %}</div></div></section></div>
{% schema %}
{"name":"WOGG - Comunidad","tag":"section","class":"section","max_blocks":9,"settings":[{"type":"text","id":"kicker","label":"Etiqueta","default":"Familia WOGG"},{"type":"text","id":"heading","label":"Título","default":"Peludos felices, familias felices"},{"type":"richtext","id":"text","label":"Descripción","default":"<p>Experiencias reales de quienes eligieron una alimentación más natural.</p>"},{"type":"header","content":"Configuración de sección"},{"type":"color_scheme","id":"color_scheme","label":"Esquema de color","default":"scheme-1"},{"type":"checkbox","id":"full_width","label":"Ancho completo","default":false},{"type":"checkbox","id":"use_background","label":"Mostrar fondo del esquema","default":false},{"type":"range","id":"padding_top","min":0,"max":100,"step":4,"unit":"px","label":"Margen superior","default":64},{"type":"range","id":"padding_bottom","min":0,"max":100,"step":4,"unit":"px","label":"Margen inferior","default":64}],"blocks":[{"type":"testimonial","name":"Testimonio","settings":[{"type":"textarea","id":"quote","label":"Testimonio","default":"Desde que come WOGG tiene más energía y disfruta cada plato."},{"type":"text","id":"author","label":"Nombre","default":"Familia WOGG"}]}],"presets":[{"name":"WOGG - Comunidad","blocks":[{"type":"testimonial","settings":{"quote":"El cambio se notó en su energía, digestión y entusiasmo a la hora de comer.","author":"Familia de Rocco"}},{"type":"testimonial","settings":{"quote":"Ingredientes reales y la tranquilidad de saber qué está comiendo.","author":"Familia de Mora"}},{"type":"testimonial","settings":{"quote":"Nos resultó simple empezar y ahora no deja nada en el plato.","author":"Familia de Olivia"}}]}]}
{% endschema %}
