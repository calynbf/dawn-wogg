{% render 'wogg-section-settings', section: section %}
<div class="wogg-base-section color-{{ section.settings.color_scheme }} gradient{% if section.settings.full_width %} wogg-base-section--full{% endif %}{% unless section.settings.use_background %} wogg-base-section--transparent{% endunless %}"><section class="wogg-section wogg-pets"><div class="page-width">
  <div class="wogg-menu-grid">{% for block in section.blocks %}<article class="wogg-menu-card" {{ block.shopify_attributes }}><h3 class="wogg-menu-card__title">{{ block.settings.title | escape }}</h3><a class="wogg-menu-card__media" href="{{ block.settings.link | default: routes.all_products_collection_url }}" aria-label="{{ block.settings.button_label | escape }}">{% if block.settings.image != blank %}{{ block.settings.image | image_url: width: 1400 | image_tag: widths: '550,750,1100,1400', sizes: '(min-width:750px) 50vw,100vw', loading: 'lazy' }}{% elsif forloop.index == 1 %}<img src="{{ 'wogg-menu-perros.png' | asset_url }}" width="1024" height="891" loading="lazy" alt="Alimento WOGG para perros">{% else %}<img src="{{ 'wogg-menu-gatos.png' | asset_url }}" width="1024" height="1024" loading="lazy" alt="Alimento WOGG para gatos">{% endif %}</a><div class="wogg-menu-card__action"><a class="wogg-button" href="{{ block.settings.link | default: routes.all_products_collection_url }}">{{ block.settings.button_label | escape }}</a></div></article>{% endfor %}</div>
</div></section></div>
{% schema %}
{"name":"WOGG - Perros y gatos","tag":"section","class":"section","max_blocks":2,"settings":[{"type":"text","id":"heading","label":"Título","default":"Elegí su alimento"},{"type":"richtext","id":"text","label":"Descripción","default":"<p>Nutrición real, pensada para cada integrante de la familia.</p>"},{"type":"header","content":"Configuración de sección"},{"type":"color_scheme","id":"color_scheme","label":"Esquema de color","default":"scheme-1"},{"type":"checkbox","id":"full_width","label":"Ancho completo","default":false},{"type":"checkbox","id":"use_background","label":"Mostrar fondo del esquema","default":false},{"type":"range","id":"padding_top","min":0,"max":100,"step":4,"unit":"px","label":"Margen superior","default":64},{"type":"range","id":"padding_bottom","min":0,"max":100,"step":4,"unit":"px","label":"Margen inferior","default":64}],"blocks":[{"type":"pet","name":"Mascota","settings":[{"type":"image_picker","id":"image","label":"Imagen"},{"type":"text","id":"title","label":"Título","default":"Perros"},{"type":"text","id":"button_label","label":"Botón","default":"Ver alimento"},{"type":"url","id":"link","label":"Enlace"}]}],"presets":[{"name":"WOGG - Perros y gatos","blocks":[{"type":"pet","settings":{"title":"Perros","button_label":"Ver alimento para perros"}},{"type":"pet","settings":{"title":"Gatos","button_label":"Ver alimento para gatos"}}]}]}
{% endschema %}
