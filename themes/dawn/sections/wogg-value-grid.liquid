{{ 'wogg-dawn-base.css' | asset_url | stylesheet_tag }}{% render 'wogg-section-settings', section: section %}
{{ 'wogg-home.css' | asset_url | stylesheet_tag }}{{ 'wogg-sections.css' | asset_url | stylesheet_tag }}
<div class="wogg-base-section color-{{ section.settings.color_scheme }} gradient{% if section.settings.full_width %} wogg-base-section--full{% endif %}"><section class="wogg-section wogg-content-section wogg-value"><div class="page-width"><header class="wogg-value__header"><div><p class="wogg-kicker">{{ section.settings.kicker | escape }}</p><h2 class="wogg-display wogg-section-title">{{ section.settings.heading | escape }}</h2></div><div class="wogg-section-copy rte">{{ section.settings.text }}</div></header><div class="wogg-grid wogg-value__grid">{% for block in section.blocks %}<article class="wogg-icon-card" {{ block.shopify_attributes }}><span class="wogg-icon-card__icon" aria-hidden="true">{{ block.settings.icon }}</span><h3>{{ block.settings.heading | escape }}</h3><p>{{ block.settings.text | escape }}</p></article>{% endfor %}</div></div></section></div>
{% schema %}
{"name":"WOGG - Beneficios","tag":"section","class":"section","max_blocks":6,"settings":[{"type":"text","id":"kicker","label":"Etiqueta","default":"Alimentación con propósito"},{"type":"text","id":"heading","label":"Título","default":"La forma en que deberían comer"},{"type":"richtext","id":"text","label":"Descripción","default":"<p>Una dieta natural de alta calidad fomenta una vida larga, feliz y saludable.</p>"},{"type":"header","content":"Configuración de sección"},{"type":"color_scheme","id":"color_scheme","label":"Esquema de color","default":"scheme-1"},{"type":"checkbox","id":"full_width","label":"Ancho completo","default":false},{"type":"range","id":"padding_top","min":0,"max":100,"step":4,"unit":"px","label":"Margen superior","default":64},{"type":"range","id":"padding_bottom","min":0,"max":100,"step":4,"unit":"px","label":"Margen inferior","default":64}],"blocks":[{"type":"benefit","name":"Beneficio","settings":[{"type":"text","id":"icon","label":"Ícono o emoji","default":"⚡"},{"type":"text","id":"heading","label":"Título","default":"Más energía"},{"type":"text","id":"text","label":"Texto","default":"Vitalidad para disfrutar cada día."}]}],"presets":[{"name":"WOGG - Beneficios","blocks":[{"type":"benefit","settings":{"icon":"⚖️","heading":"Peso corporal ideal","text":"Nutrición equilibrada para una condición saludable."}},{"type":"benefit","settings":{"icon":"⚡","heading":"Más energía","text":"Vitalidad para disfrutar cada paseo y juego."}},{"type":"benefit","settings":{"icon":"✨","heading":"Pelaje brillante","text":"Nutrientes reales que se notan por fuera."}},{"type":"benefit","settings":{"icon":"🌿","heading":"Mejor digestión","text":"Ingredientes naturales y fáciles de reconocer."}},{"type":"benefit","settings":{"icon":"🦷","heading":"Salud dental","text":"Una dieta adecuada ayuda al cuidado de sus dientes."}},{"type":"benefit","settings":{"icon":"🛡️","heading":"Más bienestar","text":"Una base nutricional para una vida larga y feliz."}}]}]}
{% endschema %}
