{% render 'wogg-section-settings', section: section %}
{% if section.blocks.size > 0 %}<div class="wogg-base-section color-{{ section.settings.color_scheme }} gradient{% if section.settings.full_width %} wogg-base-section--full{% endif %}{% unless section.settings.use_background %} wogg-base-section--transparent{% endunless %}"><section class="wogg-section wogg-ticker" aria-label="Beneficios WOGG"><div class="wogg-ticker__track">{% for copy_index in (1..2) %}<div class="wogg-ticker__group"{% if copy_index == 2 %} aria-hidden="true"{% endif %}>{% for block in section.blocks %}<span class="wogg-ticker__item" {{ block.shopify_attributes }}><span class="wogg-ticker__icon" aria-hidden="true">{% if block.settings.icon_svg != blank %}{{ block.settings.icon_svg }}{% else %}<svg xmlns="http://www.w3.org/2000/svg" width="8" height="9" viewBox="0 0 8 9" fill="none"><circle cx="4" cy="4.5" r="4" fill="currentColor"/></svg>{% endif %}</span><span class="wogg-ticker__text">{{ block.settings.text | escape }}</span></span>{% endfor %}</div>{% endfor %}</div></section></div>{% endif %}
{% schema %}
{"name":"WOGG - Banda beneficios","tag":"section","class":"section","max_blocks":8,"blocks":[{"type":"benefit","name":"Beneficio","settings":[{"type":"textarea","id":"icon_svg","label":"Icono SVG","info":"Pegá aquí el código SVG completo."},{"type":"text","id":"text","label":"Texto","default":"Ingredientes naturales"}]}],"presets":[{"name":"WOGG - Banda beneficios","blocks":[{"type":"benefit","settings":{"text":"Aprobado por veterinarios"}},{"type":"benefit","settings":{"text":"Sin harinas"}},{"type":"benefit","settings":{"text":"Alimento congelado BARF"}},{"type":"benefit","settings":{"text":"Sin conservantes"}}]}],"settings":[{"type":"header","content":"Configuración de sección"},{"type":"color_scheme","id":"color_scheme","label":"Esquema de color","default":"scheme-1"},{"type":"checkbox","id":"full_width","label":"Ancho completo","default":true},{"type":"checkbox","id":"use_background","label":"Mostrar fondo del esquema","default":true},{"type":"range","id":"padding_top","min":0,"max":100,"step":4,"unit":"px","label":"Margen superior","default":0},{"type":"range","id":"padding_bottom","min":0,"max":100,"step":4,"unit":"px","label":"Margen inferior","default":0}]}
{% endschema %}
