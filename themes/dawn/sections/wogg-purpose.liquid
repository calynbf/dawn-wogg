{% render 'wogg-section-settings', section: section %}
<div class="wogg-base-section color-{{ section.settings.color_scheme }} gradient{% if section.settings.full_width %} wogg-base-section--full{% endif %}{% unless section.settings.use_background %} wogg-base-section--transparent{% endunless %}"><section class="wogg-section wogg-content-section wogg-guarantee"><div class="page-width"><div class="wogg-guarantee__grid"><div class="wogg-guarantee__content"><h2 class="wogg-guarantee__title">{{ section.settings.heading | escape }}</h2><div class="wogg-guarantee__copy rte">{{ section.settings.text }}</div>{% if section.settings.button_label != blank %}<a class="wogg-button" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label | escape }}</a>{% endif %}</div><div class="wogg-guarantee__visual"><div class="wogg-guarantee__media">{% if section.settings.image != blank %}{{ section.settings.image | image_url: width: 1200 | image_tag: widths: '550,750,1000,1200', sizes: '(min-width:750px) 50vw,100vw', loading: 'lazy' }}{% else %}<img src="{{ 'wogg-guarantee.png' | asset_url }}" width="610" height="586" loading="lazy" alt="Dos perros comiendo alimento WOGG">{% endif %}</div><span class="wogg-guarantee__badge">CON<br>GARANTÍA</span></div></div></div></section></div>
{% schema %}
{"name":"WOGG - Propósito","tag":"section","class":"section","settings":[{"type":"image_picker","id":"image","label":"Imagen"},{"type":"text","id":"kicker","label":"Etiqueta","default":"Garantía de plato limpio"},{"type":"text","id":"heading","label":"Título","default":"Lo van a amar"},{"type":"richtext","id":"text","label":"Texto","default":"<p>Si no les gusta, te ofrecemos un reembolso de hasta 5 kg. Además, con cada compra ayudás a salvar vidas y acompañar refugios.</p>"},{"type":"text","id":"button_label","label":"Botón","default":"Quiero probar"},{"type":"url","id":"button_link","label":"Enlace"},{"type":"header","content":"Configuración de sección"},{"type":"color_scheme","id":"color_scheme","label":"Esquema de color","default":"scheme-1"},{"type":"checkbox","id":"full_width","label":"Ancho completo","default":true},{"type":"checkbox","id":"use_background","label":"Mostrar fondo del esquema","default":false},{"type":"range","id":"padding_top","min":0,"max":100,"step":4,"unit":"px","label":"Margen superior","default":64},{"type":"range","id":"padding_bottom","min":0,"max":100,"step":4,"unit":"px","label":"Margen inferior","default":64}],"presets":[{"name":"WOGG - Propósito"}]}
{% endschema %}
