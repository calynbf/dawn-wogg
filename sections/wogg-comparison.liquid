{{ 'wogg-dawn-base.css' | asset_url | stylesheet_tag }}{% render 'wogg-section-settings', section: section %}
{{ 'wogg-home.css' | asset_url | stylesheet_tag }}{{ 'wogg-sections.css' | asset_url | stylesheet_tag }}
<div class="wogg-base-section color-{{ section.settings.color_scheme }} gradient{% if section.settings.full_width %} wogg-base-section--full{% endif %}{% unless section.settings.use_background %} wogg-base-section--transparent{% endunless %}"><section class="wogg-section wogg-content-section wogg-comparison"><div class="page-width"><header class="wogg-comparison__header"><p class="wogg-kicker">{{ section.settings.kicker | escape }}</p><h2 class="wogg-display wogg-section-title">{{ section.settings.heading | escape }}</h2><div class="wogg-section-copy rte">{{ section.settings.text }}</div></header><div class="wogg-comparison__table" role="table"><div class="wogg-comparison__row" role="row"><div class="wogg-comparison__cell wogg-comparison__head" role="columnheader">Compará</div><div class="wogg-comparison__cell wogg-comparison__head" role="columnheader">{{ section.settings.our_label | escape }}</div><div class="wogg-comparison__cell wogg-comparison__head" role="columnheader">{{ section.settings.other_label | escape }}</div></div>{% for block in section.blocks %}<div class="wogg-comparison__row" role="row" {{ block.shopify_attributes }}><div class="wogg-comparison__cell" role="rowheader"><strong>{{ block.settings.feature | escape }}</strong></div><div class="wogg-comparison__cell" role="cell">{{ block.settings.ours | escape }}</div><div class="wogg-comparison__cell" role="cell">{{ block.settings.others | escape }}</div></div>{% endfor %}</div></div></section></div>
{% schema %}
{"name":"WOGG - Comparación","tag":"section","class":"section","max_blocks":8,"settings":[{"type":"text","id":"kicker","label":"Etiqueta","default":"Elegí mejor"},{"type":"text","id":"heading","label":"Título","default":"Comida real vs. ultraprocesada"},{"type":"richtext","id":"text","label":"Descripción","default":"<p>Lo que comen todos los días hace una diferencia.</p>"},{"type":"text","id":"our_label","label":"Columna WOGG","default":"WOGG BARF"},{"type":"text","id":"other_label","label":"Otra columna","default":"Balanceado tradicional"},{"type":"header","content":"Configuración de sección"},{"type":"color_scheme","id":"color_scheme","label":"Esquema de color","default":"scheme-1"},{"type":"checkbox","id":"full_width","label":"Ancho completo","default":false},{"type":"checkbox","id":"use_background","label":"Mostrar fondo del esquema","default":false},{"type":"range","id":"padding_top","min":0,"max":100,"step":4,"unit":"px","label":"Margen superior","default":64},{"type":"range","id":"padding_bottom","min":0,"max":100,"step":4,"unit":"px","label":"Margen inferior","default":64}],"blocks":[{"type":"row","name":"Fila","settings":[{"type":"text","id":"feature","label":"Criterio","default":"Ingredientes"},{"type":"text","id":"ours","label":"WOGG","default":"Reales y naturales"},{"type":"text","id":"others","label":"Alternativa","default":"Ultraprocesados"}]}],"presets":[{"name":"WOGG - Comparación","blocks":[{"type":"row","settings":{"feature":"Ingredientes","ours":"Reales y naturales","others":"Ultraprocesados"}},{"type":"row","settings":{"feature":"Conservantes","ours":"Sin conservantes","others":"Puede contener aditivos"}},{"type":"row","settings":{"feature":"Harinas y rellenos","ours":"Sin harinas","others":"Frecuentes"}},{"type":"row","settings":{"feature":"Procesamiento","ours":"Mínimo","others":"Altas temperaturas"}}]}]}
{% endschema %}
