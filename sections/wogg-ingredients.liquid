{% render 'wogg-section-settings', section: section %}
<div class="wogg-base-section color-{{ section.settings.color_scheme }} gradient{% if section.settings.full_width %} wogg-base-section--full{% endif %}{% unless section.settings.use_background %} wogg-base-section--transparent{% endunless %}"><section class="wogg-section wogg-content-section wogg-ingredients wogg-ingredients--classic"><div class="page-width"><header class="wogg-ingredients-classic__header"><h2 class="wogg-ingredients-classic__title">{{ section.settings.heading | escape }}</h2>{% if section.settings.text != blank %}<div class="wogg-ingredients-classic__copy rte">{{ section.settings.text }}</div>{% endif %}</header><div class="wogg-ingredients-classic__grid">{% for block in section.blocks %}<article class="wogg-ingredient-classic" {{ block.shopify_attributes }}><div class="wogg-ingredient-classic__media">{% if block.settings.image != blank %}{{ block.settings.image | image_url: width: 700 | image_tag: widths: '240,360,500,700', sizes: '(min-width:990px) 25vw,50vw', loading: 'lazy' }}{% else %}{{ 'product-1' | placeholder_svg_tag }}{% endif %}</div><h3>{{ block.settings.heading | escape }}</h3></article>{% endfor %}</div>{% if section.settings.button_label != blank %}<div class="wogg-ingredients-classic__action"><a class="wogg-button" href="{{ section.settings.button_link | default: '#' }}">{{ section.settings.button_label | escape }}</a></div>{% endif %}</div></section></div>
{% schema %}
{"name":"WOGG - Ingredientes","tag":"section","class":"section","max_blocks":12,"settings":[{"type":"text","id":"kicker","label":"Etiqueta","default":"Ingredientes reales"},{"type":"text","id":"heading","label":"Título","default":"¿De qué estamos hechos?"},{"type":"richtext","id":"text","label":"Descripción","default":"<p>Proteínas, vegetales y semillas seleccionadas para una nutrición completa.</p>"},{"type":"text","id":"button_label","label":"Botón","default":"Conocé todos los ingredientes"},{"type":"url","id":"button_link","label":"Enlace"},{"type":"header","content":"Configuración de sección"},{"type":"color_scheme","id":"color_scheme","label":"Esquema de color","default":"scheme-1"},{"type":"checkbox","id":"full_width","label":"Ancho completo","default":false},{"type":"checkbox","id":"use_background","label":"Mostrar fondo del esquema","default":false},{"type":"range","id":"padding_top","min":0,"max":100,"step":4,"unit":"px","label":"Margen superior","default":64},{"type":"range","id":"padding_bottom","min":0,"max":100,"step":4,"unit":"px","label":"Margen inferior","default":64}],"blocks":[{"type":"ingredient","name":"Ingrediente","settings":[{"type":"image_picker","id":"image","label":"Imagen"},{"type":"text","id":"heading","label":"Nombre","default":"Carne vacuna"},{"type":"text","id":"text","label":"Descripción","default":"Proteína de alta calidad."}]}],"presets":[{"name":"WOGG - Ingredientes","blocks":[{"type":"ingredient","settings":{"heading":"Carne vacuna","text":"Proteína de alta calidad."}},{"type":"ingredient","settings":{"heading":"Carne de pollo","text":"Proteína magra y nutritiva."}},{"type":"ingredient","settings":{"heading":"Vegetales","text":"Fibra y nutrientes naturales."}},{"type":"ingredient","settings":{"heading":"Semillas y Omega 3","text":"Grasas esenciales para su bienestar."}}]}]}
{% endschema %}
