{{ 'wogg-home.css' | asset_url | stylesheet_tag }}
<section class="wogg-section wogg-hero" aria-labelledby="WoggHeroHeading-{{ section.id }}">
  <div class="wogg-hero__media">{% if section.settings.image != blank %}{{ section.settings.image | image_url: width: 2400 | image_tag: widths: '750,1100,1500,2000,2400', sizes: '100vw', loading: 'eager', fetchpriority: 'high' }}{% else %}{{ 'lifestyle-1' | placeholder_svg_tag: 'wogg-hero__placeholder' }}{% endif %}</div>
  <div class="wogg-hero__overlay" style="--overlay-opacity:{{ section.settings.overlay_opacity | divided_by: 100.0 }}"></div>
  <div class="wogg-hero__inner page-width"><div class="wogg-hero__content">
    {% if section.settings.eyebrow != blank %}<p class="wogg-hero__eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}
    <h1 id="WoggHeroHeading-{{ section.id }}" class="wogg-display wogg-hero__heading">{{ section.settings.heading | escape }}</h1>
    {% if section.settings.text != blank %}<div class="wogg-hero__text rte">{{ section.settings.text }}</div>{% endif %}
    <div class="wogg-hero__actions">{% if section.settings.primary_label != blank %}<a class="wogg-button" href="{{ section.settings.primary_link | default: routes.all_products_collection_url }}">{{ section.settings.primary_label | escape }}</a>{% endif %}{% if section.settings.secondary_label != blank %}<a class="wogg-button wogg-button--outline" href="{{ section.settings.secondary_link | default: '#' }}">{{ section.settings.secondary_label | escape }}</a>{% endif %}</div>
  </div></div>
</section>
{% schema %}
{"name":"WOGG - Portada principal","tag":"section","class":"section","settings":[{"type":"image_picker","id":"image","label":"Imagen principal"},{"type":"range","id":"overlay_opacity","min":0,"max":90,"step":5,"unit":"%","label":"Oscurecer imagen","default":55},{"type":"text","id":"eyebrow","label":"Etiqueta","default":"10.000+ peludos felices"},{"type":"text","id":"heading","label":"Título","default":"Alimento natural para perros y gatos"},{"type":"richtext","id":"text","label":"Descripción","default":"<p>Mejorá su salud con una dieta natural equilibrada, formulada por profesionales en nutrición animal.</p>"},{"type":"text","id":"primary_label","label":"Botón principal","default":"Comprar ahora"},{"type":"url","id":"primary_link","label":"Enlace principal"},{"type":"text","id":"secondary_label","label":"Botón secundario","default":"Calcular ración"},{"type":"url","id":"secondary_link","label":"Enlace secundario"}],"presets":[{"name":"WOGG - Portada principal"}]}
{% endschema %}
