{% render 'wogg-section-settings', section: section %}
<div class="wogg-base-section color-{{ section.settings.color_scheme }} gradient{% if section.settings.full_width %} wogg-base-section--full{% endif %}{% unless section.settings.use_background %} wogg-base-section--transparent{% endunless %}"><section class="wogg-section wogg-content-section wogg-how"><div class="page-width"><header class="wogg-how__header"><h2 class="wogg-how__title">{{ section.settings.heading | escape }}</h2><div class="wogg-how__intro rte">{{ section.settings.text }}</div></header><div class="wogg-how__grid"><div class="wogg-how__media">{% if section.settings.image != blank %}{{ section.settings.image | image_url: width: 1400 | image_tag: widths: '550,750,1000,1400', sizes: '(min-width:750px) 45vw,100vw', loading: 'lazy' }}{% else %}<img src="{{ 'wogg-how-it-works.jpg' | asset_url }}" width="2560" height="2048" loading="lazy" alt="Sirviendo alimento WOGG en su plato">{% endif %}</div><div class="wogg-how__content"><div class="wogg-how__steps">{% for block in section.blocks %}<article class="wogg-how__step" {{ block.shopify_attributes }}><span class="wogg-how__number">{{ forloop.index }}</span><div><h3>{{ block.settings.heading | escape }}</h3><p>{{ block.settings.text | escape }}</p></div></article>{% endfor %}</div>{% if section.settings.button_label != blank %}<a class="wogg-button wogg-how__button" href="{{ section.settings.button_link | default: '#' }}">{{ section.settings.button_label | escape }}</a>{% endif %}</div></div></div></section></div>
{% schema %}
{"name":"WOGG - Cómo comenzar","tag":"section","class":"section","max_blocks":4,"settings":[{"type":"image_picker","id":"image","label":"Imagen"},{"type":"text","id":"kicker","label":"Etiqueta","default":"Así de fácil"},{"type":"text","id":"heading","label":"Título","default":"¿Cómo comenzar?"},{"type":"richtext","id":"text","label":"Descripción","default":"<p>En tres simples pasos</p>"},{"type":"text","id":"button_label","label":"Botón","default":"Calcular ración"},{"type":"url","id":"button_link","label":"Enlace"},{"type":"header","content":"Configuración de sección"},{"type":"color_scheme","id":"color_scheme","label":"Esquema de color","default":"scheme-1"},{"type":"checkbox","id":"full_width","label":"Ancho completo","default":false},{"type":"checkbox","id":"use_background","label":"Mostrar fondo del esquema","default":false},{"type":"range","id":"padding_top","min":0,"max":100,"step":4,"unit":"px","label":"Margen superior","default":64},{"type":"range","id":"padding_bottom","min":0,"max":100,"step":4,"unit":"px","label":"Margen inferior","default":64}],"blocks":[{"type":"step","name":"Paso","settings":[{"type":"text","id":"heading","label":"Título","default":"Elegí su menú"},{"type":"textarea","id":"text","label":"Texto","default":"Encontrá la opción ideal según sus gustos y necesidades."}]}],"presets":[{"name":"WOGG - Cómo comenzar","blocks":[{"type":"step","settings":{"heading":"Elegí el menú de tu preferencia","text":"Elegí entre nuestras opciones de sabores: Pollo, Carne o Mix de proteínas."}},{"type":"step","settings":{"heading":"Hacé tu Pedido Online","text":"Hacé tu pedido online de manera rápida y fácil."}},{"type":"step","settings":{"heading":"Recibí tu pedido sin moverte de tu casa","text":"Elegí, pedí y disfrutá. Nosotros nos ocupamos del resto."}}]}]}
{% endschema %}
