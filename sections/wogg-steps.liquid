{% render 'wogg-section-settings', section: section %}
<div class="wogg-base-section color-{{ section.settings.color_scheme }} gradient{% if section.settings.full_width %} wogg-base-section--full{% endif %}{% unless section.settings.use_background %} wogg-base-section--transparent{% endunless %}"><section class="wogg-section wogg-content-section wogg-steps"><div class="page-width"><header class="wogg-steps__header"><p class="wogg-kicker">{{ section.settings.kicker | escape }}</p><h2 class="wogg-display wogg-section-title">{{ section.settings.heading | escape }}</h2><div class="wogg-section-copy rte">{{ section.settings.text }}</div></header><div class="wogg-grid wogg-steps__grid">{% for block in section.blocks %}<article class="wogg-step" {{ block.shopify_attributes }}><p class="wogg-step__number">0{{ forloop.index }}</p><h3>{{ block.settings.heading | escape }}</h3><p>{{ block.settings.text | escape }}</p></article>{% endfor %}</div>{% if section.settings.button_label != blank %}<p><a class="wogg-button" href="{{ section.settings.button_link | default: '#' }}">{{ section.settings.button_label | escape }}</a></p>{% endif %}</div></section></div>
{% schema %}
{"name":"WOGG - Cómo comenzar","tag":"section","class":"section","max_blocks":4,"settings":[{"type":"text","id":"kicker","label":"Etiqueta","default":"Así de fácil"},{"type":"text","id":"heading","label":"Título","default":"¿Cómo comenzar?"},{"type":"richtext","id":"text","label":"Descripción","default":"<p>En tres simples pasos, comida real en su plato.</p>"},{"type":"text","id":"button_label","label":"Botón","default":"Calcular ración"},{"type":"url","id":"button_link","label":"Enlace"},{"type":"header","content":"Configuración de sección"},{"type":"color_scheme","id":"color_scheme","label":"Esquema de color","default":"scheme-1"},{"type":"checkbox","id":"full_width","label":"Ancho completo","default":false},{"type":"checkbox","id":"use_background","label":"Mostrar fondo del esquema","default":false},{"type":"range","id":"padding_top","min":0,"max":100,"step":4,"unit":"px","label":"Margen superior","default":64},{"type":"range","id":"padding_bottom","min":0,"max":100,"step":4,"unit":"px","label":"Margen inferior","default":64}],"blocks":[{"type":"step","name":"Paso","settings":[{"type":"text","id":"heading","label":"Título","default":"Elegí su menú"},{"type":"textarea","id":"text","label":"Texto","default":"Encontrá la opción ideal según sus gustos y necesidades."}]}],"presets":[{"name":"WOGG - Cómo comenzar","blocks":[{"type":"step","settings":{"heading":"Elegí su menú","text":"Elegí entre nuestras opciones para perros o gatos."}},{"type":"step","settings":{"heading":"Hacé tu pedido online","text":"Confirmá el pedido de manera rápida y simple."}},{"type":"step","settings":{"heading":"Recibilo en tu casa","text":"Nos ocupamos de llevarlo conservando su calidad."}}]}]}
{% endschema %}
