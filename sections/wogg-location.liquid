{{ 'wogg-home.css' | asset_url | stylesheet_tag }}{{ 'wogg-sections.css' | asset_url | stylesheet_tag }}
<section class="wogg-section wogg-content-section wogg-location"><div class="page-width"><p class="wogg-kicker">{{ section.settings.kicker | escape }}</p><h2 class="wogg-display wogg-section-title">{{ section.settings.heading | escape }}</h2><div class="wogg-section-copy rte">{{ section.settings.text }}</div>{% if section.settings.button_label != blank %}<a class="wogg-button" href="{{ section.settings.button_link | default: '#' }}">{{ section.settings.button_label | escape }}</a>{% endif %}</div></section>
{% schema %}
{"name":"WOGG - Cobertura","tag":"section","class":"section","settings":[{"type":"text","id":"kicker","label":"Etiqueta","default":"Llegamos a tu casa"},{"type":"text","id":"heading","label":"Título","default":"Encontrá WOGG cerca tuyo"},{"type":"richtext","id":"text","label":"Texto","default":"<p>Conocé nuestras zonas de entrega y puntos de venta.</p>"},{"type":"text","id":"button_label","label":"Botón","default":"Dónde encontrarnos"},{"type":"url","id":"button_link","label":"Enlace"}],"presets":[{"name":"WOGG - Cobertura"}]}
{% endschema %}
