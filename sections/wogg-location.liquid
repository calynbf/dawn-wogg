{{ 'wogg-dawn-base.css' | asset_url | stylesheet_tag }}{% render 'wogg-section-settings', section: section %}
{{ 'wogg-home.css' | asset_url | stylesheet_tag }}{{ 'wogg-sections.css' | asset_url | stylesheet_tag }}
<div class="wogg-base-section color-{{ section.settings.color_scheme }} gradient{% if section.settings.full_width %} wogg-base-section--full{% endif %}"><section class="wogg-section wogg-content-section wogg-location"><div class="page-width"><p class="wogg-kicker">{{ section.settings.kicker | escape }}</p><h2 class="wogg-display wogg-section-title">{{ section.settings.heading | escape }}</h2><div class="wogg-section-copy rte">{{ section.settings.text }}</div>{% if section.settings.button_label != blank %}<a class="wogg-button" href="{{ section.settings.button_link | default: '#' }}">{{ section.settings.button_label | escape }}</a>{% endif %}</div></section></div>
{% schema %}
{"name":"WOGG - Cobertura","tag":"section","class":"section","settings":[{"type":"text","id":"kicker","label":"Etiqueta","default":"Llegamos a tu casa"},{"type":"text","id":"heading","label":"Título","default":"Encontrá WOGG cerca tuyo"},{"type":"richtext","id":"text","label":"Texto","default":"<p>Conocé nuestras zonas de entrega y puntos de venta.</p>"},{"type":"text","id":"button_label","label":"Botón","default":"Dónde encontrarnos"},{"type":"url","id":"button_link","label":"Enlace"},{"type":"header","content":"Configuración de sección"},{"type":"color_scheme","id":"color_scheme","label":"Esquema de color","default":"scheme-1"},{"type":"checkbox","id":"full_width","label":"Ancho completo","default":true},{"type":"range","id":"padding_top","min":0,"max":100,"step":4,"unit":"px","label":"Margen superior","default":64},{"type":"range","id":"padding_bottom","min":0,"max":100,"step":4,"unit":"px","label":"Margen inferior","default":64}],"presets":[{"name":"WOGG - Cobertura"}]}
{% endschema %}
