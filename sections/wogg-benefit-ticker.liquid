{{ 'wogg-dawn-base.css' | asset_url | stylesheet_tag }}{% render 'wogg-section-settings', section: section %}
{{ 'wogg-home.css' | asset_url | stylesheet_tag }}
{% if section.blocks.size > 0 %}<div class="wogg-base-section color-{{ section.settings.color_scheme }} gradient{% if section.settings.full_width %} wogg-base-section--full{% endif %}"><section class="wogg-section wogg-ticker" aria-label="Beneficios WOGG"><div class="wogg-ticker__track">{% for copy_index in (1..2) %}<div class="wogg-ticker__group"{% if copy_index == 2 %} aria-hidden="true"{% endif %}>{% for block in section.blocks %}<span class="wogg-ticker__item" {{ block.shopify_attributes }}>{{ block.settings.text | escape }}</span>{% endfor %}</div>{% endfor %}</div></section></div>{% endif %}
{% schema %}
{"name":"WOGG - Banda beneficios","tag":"section","class":"section","max_blocks":8,"blocks":[{"type":"benefit","name":"Beneficio","settings":[{"type":"text","id":"text","label":"Texto","default":"Ingredientes naturales"}]}],"presets":[{"name":"WOGG - Banda beneficios","blocks":[{"type":"benefit","settings":{"text":"Aprobado por veterinarios"}},{"type":"benefit","settings":{"text":"Sin harinas"}},{"type":"benefit","settings":{"text":"Alimento congelado BARF"}},{"type":"benefit","settings":{"text":"Sin conservantes"}}]}],"settings":[{"type":"header","content":"Configuración de sección"},{"type":"color_scheme","id":"color_scheme","label":"Esquema de color","default":"scheme-1"},{"type":"checkbox","id":"full_width","label":"Ancho completo","default":true},{"type":"range","id":"padding_top","min":0,"max":100,"step":4,"unit":"px","label":"Margen superior","default":0},{"type":"range","id":"padding_bottom","min":0,"max":100,"step":4,"unit":"px","label":"Margen inferior","default":0}]}
{% endschema %}
