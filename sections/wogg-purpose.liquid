{{ 'wogg-home.css' | asset_url | stylesheet_tag }}{{ 'wogg-sections.css' | asset_url | stylesheet_tag }}
<section class="wogg-section wogg-purpose"><div class="wogg-purpose__media">{% if section.settings.image != blank %}{{ section.settings.image | image_url: width: 1600 | image_tag: widths: '750,1100,1600', sizes: '(min-width:750px) 50vw,100vw', loading: 'lazy' }}{% else %}{{ 'lifestyle-2' | placeholder_svg_tag }}{% endif %}</div><div class="wogg-purpose__content"><p class="wogg-kicker">{{ section.settings.kicker | escape }}</p><h2 class="wogg-display wogg-section-title">{{ section.settings.heading | escape }}</h2><div class="wogg-section-copy rte">{{ section.settings.text }}</div>{% if section.settings.button_label != blank %}<a class="wogg-button" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label | escape }}</a>{% endif %}</div></section>
{% schema %}
{"name":"WOGG - Propósito","tag":"section","class":"section","settings":[{"type":"image_picker","id":"image","label":"Imagen"},{"type":"text","id":"kicker","label":"Etiqueta","default":"Garantía de plato limpio"},{"type":"text","id":"heading","label":"Título","default":"Lo van a amar"},{"type":"richtext","id":"text","label":"Texto","default":"<p>Si no les gusta, te ofrecemos un reembolso de hasta 5 kg. Además, con cada compra ayudás a salvar vidas y acompañar refugios.</p>"},{"type":"text","id":"button_label","label":"Botón","default":"Quiero probar"},{"type":"url","id":"button_link","label":"Enlace"}],"presets":[{"name":"WOGG - Propósito"}]}
{% endschema %}
