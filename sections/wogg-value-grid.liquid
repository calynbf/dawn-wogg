{% render 'wogg-section-settings', section: section %}
<div class="wogg-base-section color-{{ section.settings.color_scheme }} gradient{% if section.settings.full_width %} wogg-base-section--full{% endif %}{% unless section.settings.use_background %} wogg-base-section--transparent{% endunless %}"><section class="wogg-section wogg-content-section wogg-value wogg-value--classic"><div class="page-width"><header class="wogg-value-classic__header"><h2 class="wogg-value-classic__title">{{ section.settings.heading | escape }}<br><span>Desde siempre.</span></h2><div class="wogg-value-classic__copy rte">{{ section.settings.text }}</div></header><ul class="wogg-value-classic__list" role="list">{% for block in section.blocks %}<li class="wogg-value-classic__item" {{ block.shopify_attributes }}><svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 28 28" fill="none" aria-hidden="true"><circle cx="14" cy="14" r="13" fill="#FFF200" stroke="black" stroke-width="2"/></svg><span>{{ block.settings.heading | escape }}</span></li>{% endfor %}</ul></div></section></div>
{% schema %}
{"name":"WOGG - Beneficios","tag":"section","class":"section","max_blocks":6,"settings":[{"type":"text","id":"kicker","label":"Etiqueta","default":"Alimentación con propósito"},{"type":"text","id":"heading","label":"Título","default":"La forma en que deberían comer"},{"type":"richtext","id":"text","label":"Descripción","default":"<p>Una dieta natural de alta calidad fomenta una vida larga, feliz y saludable.</p>"},{"type":"header","content":"Configuración de sección"},{"type":"color_scheme","id":"color_scheme","label":"Esquema de color","default":"scheme-1"},{"type":"checkbox","id":"full_width","label":"Ancho completo","default":false},{"type":"checkbox","id":"use_background","label":"Mostrar fondo del esquema","default":false},{"type":"range","id":"padding_top","min":0,"max":100,"step":4,"unit":"px","label":"Margen superior","default":64},{"type":"range","id":"padding_bottom","min":0,"max":100,"step":4,"unit":"px","label":"Margen inferior","default":64}],"blocks":[{"type":"benefit","name":"Beneficio","settings":[{"type":"text","id":"icon","label":"Ícono o emoji","default":"⚡"},{"type":"text","id":"heading","label":"Título","default":"Más energía"},{"type":"text","id":"text","label":"Texto","default":"Vitalidad para disfrutar cada día."}]}],"presets":[{"name":"WOGG - Beneficios","blocks":[{"type":"benefit","settings":{"icon":"⚖️","heading":"Peso corporal ideal","text":"Nutrición equilibrada para una condición saludable."}},{"type":"benefit","settings":{"icon":"⚡","heading":"Más energía","text":"Vitalidad para disfrutar cada paseo y juego."}},{"type":"benefit","settings":{"icon":"✨","heading":"Pelaje brillante","text":"Nutrientes reales que se notan por fuera."}},{"type":"benefit","settings":{"icon":"🌿","heading":"Mejor digestión","text":"Ingredientes naturales y fáciles de reconocer."}},{"type":"benefit","settings":{"icon":"🦷","heading":"Salud dental","text":"Una dieta adecuada ayuda al cuidado de sus dientes."}},{"type":"benefit","settings":{"icon":"🛡️","heading":"Más bienestar","text":"Una base nutricional para una vida larga y feliz."}}]}]}
{% endschema %}
