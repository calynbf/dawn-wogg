{% render 'wogg-section-settings', section: section %}
<div class="wogg-base-section color-{{ section.settings.color_scheme }} gradient{% if section.settings.full_width %} wogg-base-section--full{% endif %}{% unless section.settings.use_background %} wogg-base-section--transparent{% endunless %}"><section class="wogg-section wogg-content-section wogg-value wogg-value--{{ section.settings.layout }}"><div class="page-width"><header class="wogg-value-classic__header">{% if section.settings.layout == 'cards' %}<h2 class="wogg-value-cards__title">{{ section.settings.heading | escape }}</h2>{% else %}<h2 class="wogg-value-classic__title">{{ section.settings.heading | escape }}<br><span>Desde siempre.</span></h2>{% endif %}<div class="wogg-value-classic__copy rte">{{ section.settings.text }}</div></header>{% if section.settings.layout == 'cards' %}<ul class="wogg-value-cards__grid" role="list">{% for block in section.blocks %}<li class="wogg-value-card" {{ block.shopify_attributes }}><span class="wogg-value-card__icon" aria-hidden="true">{% case block.settings.icon_name %}{% when 'paw' %}{{ 'icon-paw-print.svg' | inline_asset_content }}{% when 'lightning' %}{{ 'icon-lightning-bolt.svg' | inline_asset_content }}{% when 'leaf' %}{{ 'icon-leaf.svg' | inline_asset_content }}{% when 'star' %}{{ 'icon-star.svg' | inline_asset_content }}{% when 'eye' %}{{ 'icon-eye.svg' | inline_asset_content }}{% when 'check' %}{{ 'icon-check-mark.svg' | inline_asset_content }}{% else %}{{ 'icon-heart.svg' | inline_asset_content }}{% endcase %}</span><h3>{{ block.settings.heading | escape }}</h3>{% if block.settings.text != blank %}<p>{{ block.settings.text | escape }}</p>{% endif %}</li>{% endfor %}</ul>{% else %}<ul class="wogg-value-classic__list" role="list">{% for block in section.blocks %}<li class="wogg-value-classic__item" {{ block.shopify_attributes }}><svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 28 28" fill="none" aria-hidden="true"><circle cx="14" cy="14" r="13" fill="#FFF200" stroke="black" stroke-width="2"/></svg><span>{{ block.settings.heading | escape }}</span></li>{% endfor %}</ul>{% endif %}</div></section></div>
{% schema %}
{"name":"WOGG - Beneficios","tag":"section","class":"section","max_blocks":10,"settings":[{"type":"select","id":"layout","label":"Diseño","options":[{"value":"classic","label":"Lista clásica"},{"value":"cards","label":"Tarjetas"}],"default":"classic"},{"type":"text","id":"kicker","label":"Etiqueta","default":"Alimentación con propósito"},{"type":"text","id":"heading","label":"Título","default":"La forma en que deberían comer"},{"type":"richtext","id":"text","label":"Descripción","default":"<p>Una dieta natural de alta calidad fomenta una vida larga, feliz y saludable.</p>"},{"type":"header","content":"Configuración de sección"},{"type":"color_scheme","id":"color_scheme","label":"Esquema de color","default":"scheme-1"},{"type":"checkbox","id":"full_width","label":"Ancho completo","default":false},{"type":"checkbox","id":"use_background","label":"Mostrar fondo del esquema","default":false},{"type":"range","id":"padding_top","min":0,"max":100,"step":4,"unit":"px","label":"Margen superior","default":64},{"type":"range","id":"padding_bottom","min":0,"max":100,"step":4,"unit":"px","label":"Margen inferior","default":64}],"blocks":[{"type":"benefit","name":"Beneficio","settings":[{"type":"select","id":"icon_name","label":"Ícono de tarjeta","options":[{"value":"heart","label":"Corazón"},{"value":"paw","label":"Huella"},{"value":"lightning","label":"Energía"},{"value":"leaf","label":"Hoja"},{"value":"star","label":"Estrella"},{"value":"eye","label":"Bienestar"},{"value":"check","label":"Aprobado"}],"default":"heart"},{"type":"text","id":"icon","label":"Ícono o emoji (lista clásica)","default":"⚡"},{"type":"text","id":"heading","label":"Título","default":"Más energía"},{"type":"text","id":"text","label":"Texto","default":"Vitalidad para disfrutar cada día."}]}],"presets":[{"name":"WOGG - Beneficios","blocks":[{"type":"benefit","settings":{"icon":"⚖️","heading":"Peso corporal ideal","text":"Nutrición equilibrada para una condición saludable."}},{"type":"benefit","settings":{"icon":"⚡","heading":"Más energía","text":"Vitalidad para disfrutar cada paseo y juego."}},{"type":"benefit","settings":{"icon":"✨","heading":"Pelaje brillante","text":"Nutrientes reales que se notan por fuera."}},{"type":"benefit","settings":{"icon":"🌿","heading":"Mejor digestión","text":"Ingredientes naturales y fáciles de reconocer."}},{"type":"benefit","settings":{"icon":"🦷","heading":"Salud dental","text":"Una dieta adecuada ayuda al cuidado de sus dientes."}},{"type":"benefit","settings":{"icon":"🛡️","heading":"Más bienestar","text":"Una base nutricional para una vida larga y feliz."}}]}]}
{% endschema %}
