{% render 'wogg-section-settings', section: section %}
<div class="wogg-base-section color-{{ section.settings.color_scheme }} gradient{% if section.settings.full_width %} wogg-base-section--full{% endif %}{% unless section.settings.use_background %} wogg-base-section--transparent{% endunless %}"><section class="wogg-section wogg-content-section wogg-faq"><div class="page-width wogg-faq__layout"><header><p class="wogg-kicker">{{ section.settings.kicker | escape }}</p><h2 class="wogg-display wogg-section-title">{{ section.settings.heading | escape }}</h2><div class="wogg-section-copy rte">{{ section.settings.text }}</div>{% if section.settings.button_label != blank %}<p><a class="wogg-button" href="{{ section.settings.button_link | default: '#' }}">{{ section.settings.button_label | escape }}</a></p>{% endif %}</header><div>{% for block in section.blocks %}<details {{ block.shopify_attributes }}{% if forloop.first %} open{% endif %}><summary>{{ block.settings.question | escape }}</summary><div class="wogg-faq__answer rte">{{ block.settings.answer }}</div></details>{% endfor %}</div></div></section></div>
{% schema %}
{"name":"WOGG - Preguntas","tag":"section","class":"section","max_blocks":12,"settings":[{"type":"text","id":"kicker","label":"Etiqueta","default":"Resolvemos tus dudas"},{"type":"text","id":"heading","label":"Título","default":"Preguntas frecuentes"},{"type":"richtext","id":"text","label":"Introducción","default":"<p>Todo lo que necesitás saber para empezar una alimentación natural.</p>"},{"type":"text","id":"button_label","label":"Botón","default":"Ver todas las preguntas"},{"type":"url","id":"button_link","label":"Enlace"},{"type":"header","content":"Configuración de sección"},{"type":"color_scheme","id":"color_scheme","label":"Esquema de color","default":"scheme-1"},{"type":"checkbox","id":"full_width","label":"Ancho completo","default":false},{"type":"checkbox","id":"use_background","label":"Mostrar fondo del esquema","default":false},{"type":"range","id":"padding_top","min":0,"max":100,"step":4,"unit":"px","label":"Margen superior","default":64},{"type":"range","id":"padding_bottom","min":0,"max":100,"step":4,"unit":"px","label":"Margen inferior","default":64}],"blocks":[{"type":"question","name":"Pregunta","settings":[{"type":"text","id":"question","label":"Pregunta","default":"¿Qué es la alimentación BARF?"},{"type":"richtext","id":"answer","label":"Respuesta","default":"<p>Es una alimentación biológicamente apropiada basada en ingredientes frescos y naturales.</p>"}]}],"presets":[{"name":"WOGG - Preguntas","blocks":[{"type":"question","settings":{"question":"¿Cuál es la diferencia con el alimento balanceado?","answer":"<p>WOGG utiliza ingredientes reales y un procesamiento mínimo, sin harinas ni conservantes.</p>"}},{"type":"question","settings":{"question":"¿Cuánta comida tengo que darle?","answer":"<p>La cantidad depende del peso ideal, edad y nivel de actividad. Usá nuestra calculadora de ración como guía.</p>"}},{"type":"question","settings":{"question":"¿Se debe hacer una transición?","answer":"<p>Sí. Recomendamos una transición gradual para que su sistema digestivo se adapte correctamente.</p>"}},{"type":"question","settings":{"question":"¿Cómo se conserva?","answer":"<p>Mantené los productos en el freezer y descongelá la ración diaria en la heladera.</p>"}},{"type":"question","settings":{"question":"¿Se puede cocinar?","answer":"<p>Puede sellarse levemente, aunque recomendamos evitar una cocción prolongada para preservar nutrientes.</p>"}}]}]}
{% endschema %}
